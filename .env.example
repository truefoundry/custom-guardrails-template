# Copy to .env and fill in. Do NOT commit .env.

# --- Lasso Security API ---
# API key from https://server.lasso.security
LASSO_API_KEY=
# Optional: override base URL (default: https://server.lasso.security/gateway/v3)
# LASSO_API_BASE=https://server.lasso.security/gateway/v3

# --- Wrapper auth (the TrueFoundry gateway calls us with this Bearer token) ---
WRAPPER_API_KEY=change-me-to-a-random-string

# --- Server ---
PORT=8000
LOG_LEVEL=info

# --- TrueFoundry deploy (used by deploy.py only) ---
# TFY_WORKSPACE_FQN=<workspace>:<name>
# TFY_PUBLIC_HOST=ml.<cluster>.truefoundry.cloud
# TFY_PUBLIC_PATH=/lasso-guardrails/
# LASSO_API_KEY_SECRET_FQN=tfy-secret://<workspace>/lasso-guardrails-tfy/lasso-api-key
# WRAPPER_API_KEY_SECRET_FQN=tfy-secret://<workspace>/lasso-guardrails-tfy/wrapper-api-key
